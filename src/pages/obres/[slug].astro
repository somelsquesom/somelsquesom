---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Foto from '../../components/Foto.astro';
import IconaBaixar from '../../components/IconaBaixar.astro';
import Etiquetes from '../../components/Etiquetes.astro';
import web from '../../data/web.json';
import engira from '../../data/textos/engira.json';
import arxiu from '../../data/textos/arxiu.json';
import t from '../../data/textos/obra.json';
import { embedVideo, formatMesAny, perEstrena, repDe, de, rich, variables } from '../../lib/util';

export async function getStaticPaths() {
  const obres = await getCollection('obres');
  return obres.map((obra) => ({ params: { slug: obra.id }, props: { obra } }));
}

const { obra } = Astro.props;
const d = obra.data;
const { Content } = await render(obra);
const enGira = d.estat === 'en-gira';
const teText = Boolean(obra.body && obra.body.trim());
const video = embedVideo(d.trailer);
const estrena = d.estrenaText ?? formatMesAny(d.estrena);
const rep = repDe(obra);
const v = variables({ titol: d.titol });
const R = (s?: string) => rich(s, v);

const totes = (await getCollection('obres')).sort(perEstrena);
const i = totes.findIndex((o) => o.id === obra.id);
const anterior = totes[i + 1];
const seguent = totes[i - 1];
const altresEnGira = totes.filter((o) => o.data.estat === 'en-gira' && o.id !== obra.id).slice(0, 2);

const descarregues = [
  { t: t.docDossier, f: d.dossier },
  { t: t.docRider, f: d.rider },
  { t: t.docCartell, f: d.cartell },
  { t: t.docFlyer, f: d.flyer },
  { t: t.docFotos, f: d.fotosPremsa },
].filter((x) => x.f);
---
<Base title={d.titol} description={d.resum} seccio={enGira ? '/en-gira' : '/arxiu'}>
  <section class="wrap" style="padding-top:16px">
    <div class="label" style="margin-bottom:20px">
      {enGira ? <a href="/en-gira" style="color:var(--grey)">{engira.etiqueta}</a> : <a href="/arxiu" style="color:var(--grey)">{arxiu.titolPestanya}</a>}
      {' / '}{d.temporada}
    </div>
    <Foto src={d.foto} alt={d.titol} ratio="21/9" />
    <div class="hero" style="padding-top:48px;padding-bottom:72px">
      <div>
        <div class="label accent" style="margin-bottom:12px">
          {enGira ? `${t.disponible} · ${t.estrena} ${estrena}` : `${t.estrena} ${estrena}`}
        </div>
        <h1 class="display">{d.titol}</h1>
        <div style="margin-top:20px"><Etiquetes etiquetes={d.etiquetes} textPropi={d.textPropi} gran /></div>
        {(d.autoria || d.direccio || d.grup !== 'Companyia') && (
          <div class="label" style="font-size:18px;margin-top:12px">
            {[d.autoria && de(d.autoria), d.direccio && `direcció ${de(d.direccio)}`, d.grup !== 'Companyia' && d.grup].filter(Boolean).join(' · ')}
          </div>
        )}
      </div>
      <div style="display:flex;flex-direction:column;gap:16px">
        {(d.durada || d.public || d.format || rep > 0) && (
          <div class="facts">
            {d.durada && <div><div class="k">{t.durada}</div><div>{d.durada}</div></div>}
            {d.public && <div><div class="k">{t.public}</div><div>{d.public}</div></div>}
            {d.format && <div><div class="k">{t.format}</div><div>{d.format}</div></div>}
            {rep > 0 && <div><div class="k">{t.representacions}</div><div>{rep}</div></div>}
          </div>
        )}
        {d.entradesInfo && <div class="label" style="font-size:14px">{d.entradesInfo}</div>}
        <div class="btns">
          {d.entrades && <a href={d.entrades} class="btn granat" target="_blank" rel="noopener">{t.botoEntrades}</a>}
          {d.dossier && <a href={d.dossier} class="btn" download><IconaBaixar />{enGira ? t.botoDossierGira : t.botoDossierArxiu}</a>}
          {enGira && <a href="/contractacio" class="btn ghost">{t.botoData}</a>}
        </div>
      </div>
    </div>
  </section>

  {video && (
    <section class="section">
      <div class="wrap">
        <div class="label" style="margin-bottom:28px">{t.trailer}</div>
        <div class="video"><iframe src={video} title={`${t.trailer} · ${d.titol}`} loading="lazy" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe></div>
      </div>
    </section>
  )}

  {(d.resum || teText) && (
    <section class="section">
      <div class="wrap cols">
        <div>
          <div class="label" style="margin-bottom:20px">{t.deQueVa}</div>
          {d.resum && <p class="serif" style="margin:0;font-size:34px;line-height:1.25">{d.resum}</p>}
        </div>
        {teText && <div class="prose"><Content /></div>}
      </div>
    </section>
  )}

  {(d.fitxaArtistica.length > 0 || d.fitxaTecnica.length > 0) && (
    <section class="section soft">
      <div class="wrap cols">
        {d.fitxaArtistica.length > 0 && (
          <div>
            <div class="label" style="margin-bottom:20px">{t.fitxaArtistica}</div>
            <div class="rows">{d.fitxaArtistica.map((r) => <div class="kv"><span>{r.rol}</span><span>{r.nom}</span></div>)}</div>
          </div>
        )}
        {d.fitxaTecnica.length > 0 && (
          <div>
            <div class="label" style="margin-bottom:20px">{t.fitxaTecnica}</div>
            <div class="rows">{d.fitxaTecnica.map((r) => <div class="kv"><span>{r.concepte}</span><span style="text-align:right">{r.valor}</span></div>)}</div>
          </div>
        )}
      </div>
    </section>
  )}

  {d.galeria.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head"><span>{t.galeria}</span><span>{d.galeria.length} {t.fotos}</span></div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,280px),1fr));gap:12px">
          {d.galeria.map((src, n) => <a href={src}><Foto src={src} alt={`${d.titol}, foto ${n + 1}`} ratio="4/3" /></a>)}
        </div>
      </div>
    </section>
  )}

  {(d.cartell || d.flyer || descarregues.length > 0) && (
    <section class="section">
      <div class="wrap">
        <div class="section-head"><span>{enGira ? t.material : t.cartellFlyer}</span>{enGira && t.materialSub && <span>{t.materialSub}</span>}</div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:32px;align-items:end">
          {d.cartell && (
            <figure style="margin:0;display:flex;flex-direction:column;gap:10px">
              <Foto src={d.cartell} alt={`${t.cartell} · ${d.titol}`} ratio="2/3" />
              <figcaption class="label">{t.cartell} · <a href={d.cartell} download>{t.descarregar}</a></figcaption>
            </figure>
          )}
          {d.flyer && (
            <figure style="margin:0;display:flex;flex-direction:column;gap:10px">
              <Foto src={d.flyer} alt={`${t.flyer} · ${d.titol}`} ratio="1/1.414" />
              <figcaption class="label">{t.flyer} · <a href={d.flyer} download>{t.descarregar}</a></figcaption>
            </figure>
          )}
          {enGira && descarregues.length > 0 && (
            <div class="rows">
              {descarregues.map((x) => (
                <a href={x.f} download class="kv" style="text-decoration:none"><span style="color:var(--ink)">{x.t}</span><IconaBaixar /></a>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  {(d.cites.length > 0 || d.funcions.length > 0 || d.llocs) && (
    <section class="section">
      <div class="wrap cols">
        {d.cites.length > 0 && (
          <div>
            <div class="label" style="margin-bottom:20px">{t.cites}</div>
            <div style="display:flex;flex-direction:column;gap:32px">
              {d.cites.map((c) => (
                <blockquote class="serif" style="margin:0;font-size:30px;line-height:1.25">«{c.text}»<footer class="label" style="font-family:var(--sans);font-size:14px;margin-top:8px">— {c.autor}</footer></blockquote>
              ))}
            </div>
          </div>
        )}
        {d.funcions.length === 0 && d.llocs && (
          <div>
            <div class="label" style="margin-bottom:20px">{t.onLhemFet} · {rep} {rep === 1 ? arxiu.representacio : arxiu.representacions}</div>
            <p style="margin:0;font-size:18px">{d.llocs}</p>
          </div>
        )}
        {d.funcions.length > 0 && (
          <div>
            <div class="label" style="margin-bottom:20px">{t.onLhemFet} · {d.funcions.length} {d.funcions.length === 1 ? t.funcio : t.funcions}</div>
            <div class="rows">
              {d.funcions.map((f) => (
                <div style="display:grid;grid-template-columns:150px minmax(0,1fr);gap:16px">
                  <span class="label" style="font-size:15px">{f.data}</span>
                  <span>{[f.espai, f.poblacio].filter(Boolean).join(' · ')}{f.nota && <span class="label"> · {f.nota}</span>}{f.entrades && <> · <a href={f.entrades} target="_blank" rel="noopener">{t.entrades}</a></>}</span>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  {enGira ? (
    <section class="section dark">
      <div class="wrap cols" style="align-items:center;padding-bottom:64px">
        <h2 class="display" set:html={R(t.finalTitol)} />
        <div style="display:flex;flex-direction:column;gap:10px;font-size:17px">
          <div>{web.contacteNom ? `${web.contacteNom} · ${t.produccio}` : t.produccio}</div>
          <div><a href={`mailto:${web.email}`}>{web.email}</a>{web.telefon && ` · ${web.telefon}`}</div>
          <div class="btns" style="margin-top:12px">
            {d.dossier && <a href={d.dossier} class="btn" download>{t.finalDossier}</a>}
            <a href="/contractacio" class="btn ghost">{t.botoData}</a>
          </div>
        </div>
      </div>
    </section>
  ) : (
    <section class="section">
      <div class="wrap" style="display:flex;flex-wrap:wrap;justify-content:space-between;gap:16px;padding-top:32px;padding-bottom:32px;font-size:15px">
        {anterior ? <a href={`/obres/${anterior.id}`} style="text-decoration:none">← {anterior.data.titol}</a> : <span></span>}
        <a href="/arxiu">{t.tornarArxiu}</a>
        {seguent ? <a href={`/obres/${seguent.id}`} style="text-decoration:none">{seguent.data.titol} →</a> : <span></span>}
      </div>
    </section>
  )}

  {enGira && altresEnGira.length > 0 && (
    <section class="wrap" style="padding-top:48px;padding-bottom:88px">
      <div class="section-head"><span>{t.altresGira}</span><a href="/en-gira">{t.veureTotes}</a></div>
      <div class="cols" style="gap:32px">
        {altresEnGira.map((o) => (
          <a href={`/obres/${o.id}`} style="text-decoration:none;display:grid;grid-template-columns:160px minmax(0,1fr);gap:20px;align-items:center">
            <Foto src={o.data.foto} alt={o.data.titol} ratio="1/1" />
            <div class="serif" style="font-size:32px;line-height:1.1">{o.data.titol}</div>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>
