---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import IconaBaixar from '../components/IconaBaixar.astro';
import Etiquetes from '../components/Etiquetes.astro';
import web from '../data/web.json';
import t from '../data/textos/engira.json';
import { perEstrena, rich, variables } from '../lib/util';

const obres = (await getCollection('obres', (o) => o.data.estat === 'en-gira')).sort(perEstrena);
const v = variables();
const R = (s?: string) => rich(s, v);
---
<Base title={t.titolPestanya}>
  <section class="wrap hero">
    <div>
      {t.etiqueta && <div class="label" style="margin-bottom:20px">{t.etiqueta}</div>}
      <h1 class="display" set:html={R(t.titol)} />
    </div>
    <div style="display:flex;flex-direction:column;gap:20px;max-width:480px">
      {t.presentacio && <p class="lead" set:html={R(t.presentacio)} />}
      {web.dossiersGenerals && (
        <a href={web.dossiersGenerals} class="btn ghost" style="align-self:flex-start"><IconaBaixar />{t.botoTotsDossiers}</a>
      )}
    </div>
  </section>

  <section class="section">
    <div class="wrap" style="padding-top:0">
      {obres.length === 0 && <p class="lead" style="padding:48px 0" set:html={R(t.senseObres)} />}
      {obres.map((o, i) => (
        <article class="cols" style="gap:48px;padding:48px 0;border-bottom:1px solid var(--line);align-items:center">
          {o.data.foto && <a href={`/obres/${o.id}`}><Foto src={o.data.foto} alt={o.data.titol} ratio="3/2" /></a>}
          <div style="display:flex;flex-direction:column;gap:20px">
            <div class="label accent">{[t.etiqueta, i + 1, t.disponible].filter(Boolean).join(' · ')}</div>
            <h2 class="display" style="font-size:60px;line-height:1"><a href={`/obres/${o.id}`} style="text-decoration:none">{o.data.titol}</a></h2>
            <Etiquetes etiquetes={o.data.etiquetes} textPropi={o.data.textPropi} gran />
            {o.data.resum && <p class="muted" style="font-size:18px;margin:0">{o.data.resum}</p>}
            <div class="label" style="font-size:14px;display:flex;flex-wrap:wrap;gap:8px 24px">
              {[o.data.autoria, o.data.durada, o.data.public, o.data.format].filter(Boolean).map((x) => <span>{x}</span>)}
            </div>
            {o.data.entradesInfo && <div class="label" style="font-size:14px">{o.data.entradesInfo}</div>}
            <div class="btns">
              <a href={`/obres/${o.id}`} class="btn">{t.botoVeure}</a>
              {o.data.entrades && <a href={o.data.entrades} class="btn granat" target="_blank" rel="noopener">{t.botoEntrades}</a>}
              {o.data.dossier && <a href={o.data.dossier} class="btn ghost" download><IconaBaixar />{t.botoDossier}</a>}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  {t.mostrarFinal && (
    <section class="section soft">
      <div class="wrap" style="display:flex;flex-wrap:wrap;gap:24px;justify-content:space-between;align-items:center;padding-top:56px">
        <div>
          <h2 class="display" style="font-size:52px;margin-bottom:8px" set:html={R(t.finalTitol)} />
          {t.finalText && <p class="muted" style="margin:0" set:html={R(t.finalText)} />}
        </div>
        {t.finalBoto && <a href="/contractacio" class="btn">{t.finalBoto}</a>}
      </div>
    </section>
  )}
</Base>
