---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Foto from '../../components/Foto.astro';
import web from '../../data/web.json';
import t from '../../data/textos/noticies.json';
import { perData, formatData, rich, variables } from '../../lib/util';
const v = variables();
const R = (s?: string) => rich(s, v);

const noticies = (await getCollection('noticies')).sort(perData);
const destacada = noticies.find((n) => n.data.destacada) ?? noticies[0];
const resta = noticies.filter((n) => n !== destacada);
const premsa = (await getCollection('premsa')).sort(perData);
---
<Base title={t.titolPestanya}>
  <section class="wrap hero" style="padding-bottom:48px">
    <div>
      {t.etiqueta && <div class="label accent" style="margin-bottom:20px">{t.etiqueta}</div>}
      <h1 class="display" set:html={R(t.titol)} />
    </div>
    {t.presentacio && <p class="lead" set:html={R(t.presentacio)} />}
  </section>

  {destacada && (
    <section class="section">
      <div class="wrap" style="padding-bottom:56px">
        <a href={`/noticies/${destacada.id}`} class="cols" style="text-decoration:none;gap:40px;align-items:center">
          <Foto src={destacada.data.foto} alt={destacada.data.titol} portada />
          <div style="display:flex;flex-direction:column;gap:16px">
            <div class="label"><span class="accent">{t.destacat}</span> · {formatData(destacada.data.data)}</div>
            <h2 class="display" style="font-size:56px">{destacada.data.titol}</h2>
            {destacada.data.entradeta && <p class="muted" style="font-size:18px;margin:0">{destacada.data.entradeta}</p>}
            <span style="font-size:14px;border-bottom:1px solid var(--ink);align-self:flex-start">{t.llegirMes}</span>
          </div>
        </a>
      </div>
    </section>
  )}

  {resta.length > 0 && (
    <section class="section">
      <div class="wrap" style="padding-top:48px">
        <div class="grid-cards" style="grid-template-columns:repeat(auto-fill,minmax(min(100%,300px),1fr));gap:48px 32px">
          {resta.map((n) => (
            <a href={`/noticies/${n.id}`} class="card" style="gap:12px">
              <Foto src={n.data.foto} alt={n.data.titol} portada />
              <div class="label">{formatData(n.data.data)}</div>
              <div class="card-title">{n.data.titol}</div>
              {n.data.entradeta && <div class="muted" style="font-size:15px">{n.data.entradeta}</div>}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {t.mostrarPremsa && premsa.length > 0 && (
    <section class="section soft" id="premsa">
      <div class="wrap cols">
        <div>
          <div class="label accent" style="margin-bottom:20px">{t.premsaEtiqueta}</div>
          <h2 class="display" style="margin-bottom:16px" set:html={R(t.premsaTitol)} />
          {t.premsaText && <p class="muted" style="font-size:17px;max-width:420px;margin:0" set:html={R(t.premsaText)} />}
        </div>
        <div class="rows">
          {premsa.map((p) => {
            const Tag = p.data.enllac ? 'a' : 'div';
            return (
              <Tag href={p.data.enllac} style="display:grid;grid-template-columns:110px minmax(0,1fr) auto;gap:20px;align-items:baseline;text-decoration:none">
                <span class="label">{p.data.dataText ?? formatData(p.data.data)}</span>
                <span><span class="label" style="display:block">{p.data.mitja}</span><span class="serif" style="font-size:26px;line-height:1.15">{p.data.titol}</span></span>
                <span style="font-size:13px;white-space:nowrap">{p.data.tipus}{p.data.enllac ? ' ↗' : ''}</span>
              </Tag>
            );
          })}
        </div>
      </div>
    </section>
  )}
</Base>
