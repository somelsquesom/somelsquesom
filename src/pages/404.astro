---
import Base from '../layouts/Base.astro';
import peu from '../data/textos/peu.json';
import { rich, variables } from '../lib/util';
const R = (s?: string) => rich(s, variables());
---
<Base title="404">
  <section class="wrap hero" style="padding-bottom:120px">
    <h1 class="display" set:html={R(peu.pagina404Titol)} />
    <div style="display:flex;flex-direction:column;gap:20px">
      {peu.pagina404Text && <p class="lead" set:html={R(peu.pagina404Text)} />}
      {peu.pagina404Boto && <a href="/" class="btn" style="align-self:flex-start">{peu.pagina404Boto}</a>}
    </div>
  </section>
</Base>
