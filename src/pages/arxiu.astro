---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import Etiquetes from '../components/Etiquetes.astro';
import web from '../data/web.json';
import altres from '../data/altres-actuacions.json';
import t from '../data/textos/arxiu.json';
import { perEstrena, repDe, rich, variables } from '../lib/util';
const v = variables();
const R = (s?: string) => rich(s, v);

const obres = (await getCollection('obres')).sort(perEstrena);

// Agrupem per any (o temporada), del més recent al més antic.
type Altra = { titol: string; grup: string; llocs?: string; href?: string };
const grups = new Map<string, { obres: typeof obres; altres: Altra[] }>();
const grup = (k: string) => {
  if (!grups.has(k)) grups.set(k, { obres: [], altres: [] });
  return grups.get(k)!;
};
// Obres principals: fitxa gran amb foto. Obres secundàries: només a la llista «També vam fer».
const principals = obres.filter((o) => !o.data.secundaria);
const teFitxa = (o: (typeof obres)[number]) => Boolean(o.data.foto || o.data.cartell || o.data.galeria.length || o.data.resum || o.body?.trim());
for (const o of principals) grup(o.data.temporada).obres.push(o);
for (const o of obres.filter((o) => o.data.secundaria))
  grup(o.data.temporada).altres.push({ titol: o.data.titol, grup: o.data.grup, llocs: o.data.llocs, href: teFitxa(o) ? `/obres/${o.id}` : undefined });
for (const a of altres.actuacions ?? []) grup(String(a.any)).altres.push(a);
const ordenats = [...grups].sort(([a], [b]) => b.localeCompare(a));

// Totes les etiquetes que s'han fet servir, per al filtre.
const etiquetes = [...new Set(principals.flatMap((o) => [...(o.data.textPropi ? ['Text propi'] : []), ...o.data.etiquetes]))].sort((a, b) => a.localeCompare(b, 'ca'));
const etiquetesDe = (o: (typeof obres)[number]) => [...(o.data.textPropi ? ['Text propi'] : []), ...o.data.etiquetes].join('|');
---
<Base title={t.titolPestanya}>
  <section class="wrap hero" style="padding-bottom:48px">
    <div>
      {t.etiqueta && <div class="label accent" style="margin-bottom:20px">{t.etiqueta}</div>}
      <h1 class="display" set:html={R(t.titol)} />
    </div>
    {t.presentacio && <p class="lead" set:html={R(t.presentacio)} />}
  </section>

  {t.mostrarFiltre && etiquetes.length > 0 && (
    <section class="wrap" style="padding-bottom:16px">
      <div class="filtre" role="group" aria-label="Filtra per etiqueta">
        <span class="label" style="margin-right:8px">{t.filtra}</span>
        <button type="button" data-filtre="" aria-pressed="true">{t.totes}</button>
        {etiquetes.map((e) => <button type="button" data-filtre={e} aria-pressed="false">{e}</button>)}
      </div>
    </section>
  )}

  <section class="wrap" style="padding-bottom:96px">
    {ordenats.map(([any, g]) => (
      <div class="any" style="padding:40px 0;border-top:1px solid var(--line)">
        <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline;gap:12px;margin-bottom:28px">
          <h2 class="serif" style="margin:0;font-size:44px;line-height:1">{any}</h2>
          <span class="label">
            {[g.obres.length && `${g.obres.length} ${g.obres.length === 1 ? 'obra' : 'obres'}`, t.mostrarAltres && g.altres.length && `${g.altres.length} ${g.altres.length === 1 ? 'actuació' : 'actuacions'} més`].filter(Boolean).join(' · ')}
          </span>
        </div>
        {g.obres.length > 0 && (
          <div class="llista-h petita llista-arxiu">
            {g.obres.map((o) => (
              <a href={`/obres/${o.id}`} class="card-h obra" data-etiquetes={etiquetesDe(o)}>
                <Foto src={o.data.foto || o.data.cartell} alt={o.data.titol} portada encaixa={!o.data.foto} />
                <div class="card-h-text">
                <div class="card-title" style="font-size:28px">{o.data.titol}</div>
                {(o.data.grup !== 'Companyia' || o.data.resum) && (
                  <div class="muted" style="font-size:14px">{[o.data.grup !== 'Companyia' ? o.data.grup : '', o.data.resum].filter(Boolean).join(' · ')}</div>
                )}
                <Etiquetes etiquetes={o.data.etiquetes} textPropi={o.data.textPropi} />
                <div class="label" style="display:flex;flex-wrap:wrap;gap:6px 16px">
                  {repDe(o) > 0 && <span>{repDe(o)} {repDe(o) === 1 ? t.representacio : t.representacions}</span>}
                  {o.data.estat === 'en-gira' && <span class="accent">{t.enGira}</span>}
                </div>
                </div>
              </a>
            ))}
          </div>
        )}
        {t.mostrarAltres && g.altres.length > 0 && (
          <div class="altres rows" style="margin-top:28px">
            <div class="label accent" style="border-top:0;padding-top:0">{t.tambe}</div>
            {g.altres.map((a) => (
              <div style="display:grid;grid-template-columns:minmax(0,1fr) auto;gap:16px">
                <span>{a.href ? <a href={a.href}>{a.titol}</a> : a.titol}{a.grup !== 'Companyia' && <span class="label"> · {a.grup}</span>}</span>
                <span class="label" style="text-align:right">{a.llocs}</span>
              </div>
            ))}
          </div>
        )}
      </div>
    ))}
  </section>

  <script>
    // Filtre per etiquetes: amaga les obres que no tenen l'etiqueta triada.
    const botons = document.querySelectorAll<HTMLButtonElement>('[data-filtre]');
    botons.forEach((b) =>
      b.addEventListener('click', () => {
        const f = b.dataset.filtre ?? '';
        botons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        document.querySelectorAll<HTMLElement>('.obra').forEach((o) => {
          o.hidden = f !== '' && !(o.dataset.etiquetes ?? '').split('|').includes(f);
        });
        document.querySelectorAll<HTMLElement>('.any').forEach((any) => {
          const visibles = any.querySelectorAll('.obra:not([hidden])').length;
          any.hidden = f !== '' && visibles === 0;
          any.querySelectorAll<HTMLElement>('.altres').forEach((a) => (a.hidden = f !== ''));
        });
      })
    );
  </script>
</Base>
