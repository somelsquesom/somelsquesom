---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import web from '../data/web.json';
import t from '../data/textos/companyia.json';
import { perEstrena, xifres, rich, variables } from '../lib/util';

const obres = (await getCollection('obres')).sort(perEstrena);
const x = xifres(obres);
const v = variables({}, obres);
const R = (s?: string) => rich(s, v);
// La història es construeix sola a partir de les estrenes (de la primera a la darrera).
const fites = [...obres].reverse();
const xifresLlista = [[x.anys, t.xifres?.anys], [x.obres, t.xifres?.obres], [x.representacions, t.xifres?.representacions], [x.poblacions, t.xifres?.poblacions]].filter(([n, l]) => Number(n) > 0 && l);
---
<Base title={t.titolPestanya}>
  <section class="wrap hero">
    <div>
      {t.etiqueta && <div class="label" style="margin-bottom:20px">{t.etiqueta}</div>}
      <h1 class="display" set:html={R(t.titol)} />
    </div>
    <p class="lead" style="font-size:20px;max-width:520px" set:html={R(t.presentacio || web.presentacioLlarga || web.presentacio)} />
  </section>

  {web.fotoGrup && (
    <section class="wrap">
      <Foto src={web.fotoGrup} alt="Foto de grup de la companyia" ratio="21/9" />
    </section>
  )}

  {t.mostrarXifres && xifresLlista.length > 0 && (
    <section class="wrap" style="padding-top:72px;padding-bottom:96px">
      <div class="stats">
        {xifresLlista.map(([n, l]) => <div><div class="n">{n}</div><div class="label" style="font-size:14px">{l}</div></div>)}
      </div>
    </section>
  )}

  {t.mostrarHistoria && (
    <section class="section">
      <div class="wrap cols">
        <div>
          {t.historiaEtiqueta && <div class="label" style="margin-bottom:24px">{t.historiaEtiqueta}</div>}
          <h2 class="display" set:html={R(t.historiaTitol)} />
        </div>
        <div class="rows">
          {fites.map((o) => (
            <a href={`/obres/${o.id}`} style="display:grid;grid-template-columns:100px minmax(0,1fr);gap:24px;text-decoration:none">
              <div class="serif accent" style="font-size:28px">{o.data.estrena.getFullYear()}</div>
              <div>
                <div style="font-weight:600">{o.data.titol}</div>
                <div class="muted" style="font-size:15px">{[o.data.grup, o.data.resum].filter(Boolean).join(' · ')}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section soft">
    <div class="wrap">
      <div class="section-head"><span>{t.somEtiqueta}</span><span>{t.somEtiqueta2}</span></div>
      <div class={web.fotoGrup ? 'cols' : ''} style="align-items:start">
        <div>
          <h2 class="display" style="margin-bottom:24px" set:html={R(t.somTitol)} />
          <p class="muted" style="font-size:18px;margin:0;max-width:640px" set:html={R(web.somTotsITotes)} />
        </div>
        <Foto src={web.fotoGrup} alt="Foto de grup" ratio="3/2" />
      </div>
      {web.noms.length > 0 && (
        <div style="margin-top:56px;border-top:1px solid var(--line);padding-top:28px">
          <div class="label" style="margin-bottom:16px" set:html={R(t.nomsEtiqueta)} />
          <p class="serif" style="margin:0;font-size:30px;line-height:1.45">{web.noms.join(' · ')}</p>
        </div>
      )}
    </div>
  </section>

  {t.mostrarFinal && (
    <section class="section">
      <div class="wrap" style="display:flex;flex-wrap:wrap;gap:24px;justify-content:space-between;align-items:center;padding-top:56px;padding-bottom:96px">
        <h2 class="display" style="font-size:56px" set:html={R(t.finalTitol)} />
        <div class="btns">
          {t.finalBoto1?.text && <a href={t.finalBoto1.enllac} class="btn">{t.finalBoto1.text}</a>}
          {t.finalBoto2?.text && <a href={t.finalBoto2.enllac} class="btn ghost">{t.finalBoto2.text}</a>}
        </div>
      </div>
    </section>
  )}
</Base>
