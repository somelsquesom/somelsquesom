---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import IconaBaixar from '../components/IconaBaixar.astro';
import web from '../data/web.json';
import t from '../data/textos/contractacio.json';
import { rich, variables } from '../lib/util';
const v = variables();
const R = (s?: string) => rich(s, v);

const enGira = await getCollection('obres', (o) => o.data.estat === 'en-gira');
// Si teniu un servei de formulari (p. ex. Formspree), poseu-ne l'adreça a "formulari" (Dades de la web).
// Si no, el formulari obre el correu de qui el fa servir, adreçat a la companyia.
const action = web.formulari || `mailto:${web.email}`;
// Les preguntes freqüents s'editen a «Dades de la web». Si no n'hi ha cap, la secció no surt.
const faq = (web.preguntes ?? []).filter((p: { pregunta?: string; resposta?: string }) => p.pregunta && p.resposta);
---
<Base title={t.titolPestanya}>
  <section class="wrap hero">
    <div>
      {t.etiqueta && <div class="label" style="margin-bottom:20px">{t.etiqueta}</div>}
      <h1 class="display" set:html={R(t.titol)} />
    </div>
    {t.presentacio && <p class="lead" set:html={R(t.presentacio)} />}
  </section>

  <section class="section">
    <div class="wrap cols" style="gap:64px;padding-top:48px">
      <div style="display:flex;flex-direction:column;gap:32px">
        <div>
          <div class="label">{t.produccio}</div>
          {web.contacteNom && <div class="serif" style="font-size:36px;line-height:1.1">{web.contacteNom}</div>}
        </div>
        <div class="rows" style="border-bottom:1px solid var(--line)">
          <div class="kv"><span>{t.correu}</span><a href={`mailto:${web.email}`}>{web.email}</a></div>
          {web.telefon && <div class="kv"><span>{t.telefon}</span><span>{web.telefon}</span></div>}
          <div class="kv"><span>{t.onSom}</span><span style="text-align:right">{web.poblacio} · {web.codiPostal} {web.provincia}</span></div>
        </div>
        {enGira.some((o) => o.data.dossier) && (
          <div>
            <div class="label" style="margin-bottom:12px">{t.dossiers}</div>
            <div class="rows">
              {enGira.filter((o) => o.data.dossier).map((o) => (
                <a href={o.data.dossier} download class="kv" style="text-decoration:none"><span style="color:var(--ink)">{o.data.titol}</span><IconaBaixar /></a>
              ))}
            </div>
          </div>
        )}
      </div>

      {t.mostrarFormulari && (
      <form class="form" action={action} method="post" enctype={web.formulari ? undefined : 'text/plain'}>
        <div class="serif" style="font-size:36px;line-height:1.1">{t.formTitol}</div>
        <div class="form-grid">
          <label>{t.campNom}<input type="text" name="nom" required /></label>
          <label>{t.campEntitat}<input type="text" name="entitat" /></label>
          <label>{t.campCorreu}<input type="email" name="correu" required /></label>
          <label>{t.campTelefon}<input type="tel" name="telefon" /></label>
          <label>{t.campObra}
            <select name="obra">
              {enGira.map((o) => <option>{o.data.titol}</option>)}
              <option>{t.campObraNoSe}</option>
            </select>
          </label>
          <label>{t.campData}<input type="date" name="data" /></label>
        </div>
        <label>{t.campMissatge}<textarea name="missatge" rows="5"></textarea></label>
        <label class="check"><input type="checkbox" required />{t.acceptacio}</label>
        <button type="submit" class="btn">{t.boto}</button>
      </form>
      )}
    </div>
  </section>

  {faq.length > 0 && (
  <section class="section">
    <div class="wrap cols">
      <div>
        <div class="label" style="margin-bottom:20px">{t.faqEtiqueta}</div>
        <h2 class="display" style="font-size:52px" set:html={R(t.faqTitol)} />
      </div>
      <div>
        {faq.map((q: { pregunta: string; resposta: string }) => (
          <details><summary>{q.pregunta}</summary><p class="muted" style="margin:10px 0 0">{q.resposta}</p></details>
        ))}
      </div>
    </div>
  </section>
  )}
</Base>
