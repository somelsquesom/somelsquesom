---
import '../styles/global.css';
import web from '../data/web.json';
import menu from '../data/textos/menu.json';
import peu from '../data/textos/peu.json';
import estil from '../data/textos/estil.json';
import { omple, variables } from '../lib/util';

interface Props {
  title?: string;
  description?: string;
  seccio?: string;
}
const { title, description = web.presentacio } = Astro.props;
const fullTitle = title ? `${title} · ${web.nom}` : `${web.nom} · Teatre amateur de ${web.poblacio}`;
const vars = variables();
const ruta = Astro.url.pathname.replace(/\/$/, '') || '/';
const actiu = (enllac: string) => enllac !== '/' && (ruta === enllac.replace(/\/$/, '') || ruta.startsWith(enllac.replace(/\/$/, '') + '/'));
const extern = (enllac: string) => /^https?:\/\//.test(enllac);
const colors = [
  `--accent:${estil.colorDestacat}`,
  `--granat:${estil.colorDestacat}`,
  `--granat-fosc:${estil.colorDestacatFosc}`,
  `--ink:${estil.colorText}`,
  `--bg:${estil.colorFons}`,
  `--soft:${estil.colorFonsSuau}`,
].join(';');
// Obres en gira i arxiu: la fitxa d'una obra marca la secció corresponent del menú.
const seccioObra = Astro.props.seccio;
---
<!doctype html>
<html lang="ca" style={colors}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter+Tight:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body class:list={{ franja: estil.franjaSuperior }}>
    <header class="wrap site-header">
      <a href="/" class="logo">{web.nom}</a>
      <nav class="site-nav" aria-label="Menú principal">
        {(menu.elements ?? []).map((item) => (
          <a href={item.enllac} aria-current={actiu(item.enllac) || seccioObra === item.enllac ? 'page' : undefined} target={extern(item.enllac) ? '_blank' : undefined}>{item.text}</a>
        ))}
        {menu.boto?.text && <a href={menu.boto.enllac} class="btn">{menu.boto.text}</a>}
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-cols">
        <div>
          <div style="font-weight:600;letter-spacing:.14em;margin-bottom:10px">{web.nom}</div>
          <div class="label">{peu.descripcio || web.descripcio}</div>
        </div>
        <div>
          <div class="label">{peu.onSom}</div>
          <div>{web.poblacio}<br />{web.codiPostal} · {web.provincia}</div>
        </div>
        <div>
          <div class="label">{peu.contacte}</div>
          <div>
            {web.contacteNom && <>{web.contacteNom} · {peu.produccio}<br /></>}
            <a href={`mailto:${web.email}`}>{web.email}</a>
            {web.telefon && <><br />{web.telefon}</>}
          </div>
        </div>
        <div>
          <div class="label">{peu.xarxes}</div>
          <div class="social">
            {!web.instagram && !web.tiktok && !web.facebook && <span class="label">{peu.senseXarxes}</span>}
            {web.instagram && (
              <a href={`https://www.instagram.com/${web.instagram.replace('@', '')}`} rel="me" aria-label="Instagram" title={`Instagram @${web.instagram.replace('@', '')}`}>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" /></svg>
              </a>
            )}
            {web.tiktok && (
              <a href={`https://www.tiktok.com/@${web.tiktok.replace('@', '')}`} rel="me" aria-label="TikTok" title={`TikTok @${web.tiktok.replace('@', '')}`}>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5" /><path d="M14 3c.6 2.8 2.6 4.6 5.5 4.8" /></svg>
              </a>
            )}
            {web.facebook && (
              <a href={web.facebook} rel="me" aria-label="Facebook" title="Facebook">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8z" /></svg>
              </a>
            )}
          </div>
        </div>
      </div>
      <div class="wrap footer-bottom">
        <span>{omple(peu.copyright, vars)}</span>
        {peu.enllacFinal?.text && <a href={peu.enllacFinal.enllac}>{peu.enllacFinal.text}</a>}
      </div>
    </footer>

    <!-- Visor de fotos: s'obre en clicar qualsevol foto d'una galeria o un cartell -->
    <dialog class="visor" aria-label="Visor de fotos">
      <img alt="" />
      <button type="button" class="visor-tancar" aria-label="Tancar">✕</button>
      <button type="button" class="visor-ant" aria-label="Foto anterior">‹</button>
      <button type="button" class="visor-seg" aria-label="Foto següent">›</button>
      <div class="visor-compte"></div>
    </dialog>
    <script>
      const visor = document.querySelector<HTMLDialogElement>('dialog.visor')!;
      const img = visor.querySelector('img')!;
      const compte = visor.querySelector<HTMLElement>('.visor-compte')!;
      let llista: HTMLAnchorElement[] = [];
      let i = 0;
      const mostra = (n: number) => {
        i = (n + llista.length) % llista.length;
        img.src = llista[i].href;
        img.alt = llista[i].querySelector('img')?.alt ?? '';
        compte.textContent = llista.length > 1 ? `${i + 1} / ${llista.length}` : '';
        visor.classList.toggle('sola', llista.length < 2);
      };
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-galeria]');
        if (!a || e.metaKey || e.ctrlKey) return;
        e.preventDefault();
        llista = [...document.querySelectorAll<HTMLAnchorElement>(`a[data-galeria="${a.dataset.galeria}"]`)];
        mostra(llista.indexOf(a));
        visor.showModal();
      });
      visor.querySelector('.visor-tancar')!.addEventListener('click', () => visor.close());
      visor.querySelector('.visor-ant')!.addEventListener('click', () => mostra(i - 1));
      visor.querySelector('.visor-seg')!.addEventListener('click', () => mostra(i + 1));
      // Clicar fora de la foto tanca el visor
      visor.addEventListener('click', (e) => { if (e.target === visor) visor.close(); });
      document.addEventListener('keydown', (e) => {
        if (!visor.open) return;
        if (e.key === 'ArrowLeft') mostra(i - 1);
        if (e.key === 'ArrowRight') mostra(i + 1);
      });
      // Lliscar amb el dit al mòbil
      let x0 = 0;
      visor.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
      visor.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - x0;
        if (Math.abs(dx) > 50) mostra(dx < 0 ? i + 1 : i - 1);
      });
    </script>
  </body>
</html>
